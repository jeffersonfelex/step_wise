# StepWise - variáveis de ambiente (exemplo)
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commitar o arquivo .env (já está no .gitignore).

# --- Meta DAT (Device Access Toolkit) ---
META_DAT_API_KEY=
META_DAT_ENV=sandbox

# --- Build / assinatura Android (uso local, opcional) ---
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# --- Pipeline de treino/exportação do detector visual (ml/) ---
DATASET_DIR=./ml/data
MEDIAPIPE_MODEL_OUTPUT_DIR=./ml/models
LITERT_EXPORT_DIR=./ml/models/litert

# --- Telemetria / logging local ---
LOG_LEVEL=DEBUG
