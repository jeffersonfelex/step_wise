<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" /> <!-- necessária para AudioManager.startBluetoothSco() -->
    <uses-permission android:name="android.permission.CAMERA" /> <!-- controle via Meta DAT -->
    <uses-permission android:name="android.permission.INTERNET" /> <!-- tutores remotos (Gemini Live, Groq) com conexão explícita -->
    <!-- O app instala e abre o guia manual mesmo sem estes recursos. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <application
        android:name=".StepWiseApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.StepWise"
        android:supportsRtl="true">

        <!-- Sem telemetria/crash report do SDK Meta DAT (ver docs/lgpd-privacidade.md). -->
        <meta-data android:name="com.meta.wearable.mwdat.ANALYTICS_OPT_OUT" android:value="true" />
        <meta-data android:name="com.meta.wearable.mwdat.CRASH_REPORTING_OPT_OUT" android:value="true" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.HardwareSessionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SoftwareSessionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.PrivacyActivity"
            android:exported="false" />

    </application>

</manifest>
