<resources>

    <style name="Widget.StepWise.Button.Filled" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.StepWise.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.StepWise.Button.Destructive" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/error</item>
        <item name="android:textColor">@color/error</item>
    </style>

    <style name="Widget.StepWise.Button.Success" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/success</item>
        <item name="android:textColor">@color/success</item>
    </style>

    <style name="Widget.StepWise.Button.Warning" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/warning</item>
        <item name="android:textColor">@color/warning</item>
    </style>

    <style name="Widget.StepWise.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

</resources>
